---
import Inner from '../../layouts/Inner.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('usluge')).map(item=>({params:{slug:item.id},props:{item}}))}
const {item}=Astro.props;const {Content}=await render(item);
---
<Inner title={item.data.seo_title} description={item.data.description}><a href="/">Početna</a> / Usluge<h1>{item.data.title}</h1><p class="intro">{item.data.description}</p><img class="feature" src={item.data.image} alt={item.data.title}/><article><Content/></article><p class="legal-note">Informacije su općenite i ne zamjenjuju individualni pregled.</p></Inner>
