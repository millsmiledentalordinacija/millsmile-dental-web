---
import Inner from '../../../layouts/Inner.astro';
import {OTHER_LANGS} from '../../../lib/i18n.mjs';
import {T} from '../../../i18n/pages.mjs';
export function getStaticPaths(){return OTHER_LANGS.map(lang=>({params:{lang}}))}
const {lang}=Astro.params;const t=T[lang].blog;
---
<Inner title={t.title} description={t.desc}><h1>Blog</h1><p class="intro">{t.intro}</p><p>{t.empty}</p><p><a href="/blog/" hreflang="hr" style="color:#067a65;font-weight:700;text-decoration:underline;text-underline-offset:4px">{t.link} →</a></p></Inner>
