---
import Inner from '../../layouts/Inner.astro';import {getCollection} from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Inner title="Savjeti o dentalnom zdravlju" description="Stručni savjeti i edukativni članci o oralnom zdravlju, protetici, implantologiji i prevenciji iz ordinacije Mill&Smile Dental u Zagrebu."><h1>Blog</h1><p class="intro">Novosti i korisne informacije o oralnom zdravlju.</p><div class="subgrid">{posts.map(post=><a class="subcard" href={`/blog/${post.id}/`}>{post.data.image&&<img class="blogimg" src={post.data.image} alt=""/>}<h2>{post.data.title}</h2><p>{post.data.description}</p></a>)}</div>{posts.length===0&&<p>Pripremamo prve stručne članke.</p>}</Inner>
