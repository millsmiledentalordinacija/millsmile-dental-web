---
import Inner from '../../layouts/Inner.astro';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>!data.draft)).map(item=>({params:{slug:item.id},props:{item}}))}
const {item}=Astro.props;const {Content}=await render(item);
---
<Inner title={item.data.title} description={item.data.description}><a href="/blog/">Blog</a><h1>{item.data.title}</h1><p class="legal-note">{item.data.date.toLocaleDateString('hr-HR')}</p>{item.data.image&&<img class="feature" src={item.data.image} alt=""/>}<article><Content/></article></Inner>
