---
import Layout from '../layouts/Layout.astro';
import home from '../data/home.json';
import homepageHtml from '../data/home.html?raw';
import {buildHome} from '../lib/home.mjs';
const {html}=buildHome({html:homepageHtml,home,lang:'hr',branch:globalThis.process?.env?.CF_PAGES_BRANCH||''});
---
<Layout title={home.seo_naslov} description={home.seo_opis}><div set:html={html}/></Layout>
