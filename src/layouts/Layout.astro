---
// Fontovi se poslužuju s vlastite domene (bez Google Fonts), kako bi DM Sans i Manrope stvarno bili prikazani.
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/manrope';
import {LANGS,OG_LOCALE,splitPath,localPath} from '../lib/i18n.mjs';
const {title='Mill&Smile Dental',description='Stomatološka ordinacija Mill&Smile Dental u Zagrebu.',image='/images/recepcija.webp',type='website',alternates=true}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).href;
// Jezik stranice i hreflang poveznice na ostale jezične verzije iste stranice.
const {lang,base}=splitPath(Astro.url.pathname);
const alt=alternates?LANGS.map(l=>({l,href:new URL(localPath(l,base),Astro.site).href})):[];
const structured={ '@context':'https://schema.org','@type':'Dentist','@id':'https://info-millsmiledental.com/#ordinacija',name:'Mill&Smile Dental',url:'https://info-millsmiledental.com/',image:'https://info-millsmiledental.com/images/recepcija.webp',address:{'@type':'PostalAddress',streetAddress:'Ilica 253',postalCode:'10000',addressLocality:'Zagreb',addressCountry:'HR'},telephone:'+385992411982',email:'ordinacija@info-millsmiledental.com',hasOfferCatalog:{'@type':'OfferCatalog',name:'Stomatološke usluge',itemListElement:[{ '@type':'OfferCatalog',name:'Implantologija i All-on-X',url:'https://info-millsmiledental.com/usluge/implantologija/'},{'@type':'OfferCatalog',name:'Dentalna protetika',url:'https://info-millsmiledental.com/usluge/protetika/'},{'@type':'OfferCatalog',name:'Estetska stomatologija',url:'https://info-millsmiledental.com/usluge/estetska-stomatologija/'},{'@type':'OfferCatalog',name:'Ortodoncija',url:'https://info-millsmiledental.com/usluge/ortodoncija/'},{'@type':'OfferCatalog',name:'Preventiva i higijena',url:'https://info-millsmiledental.com/usluge/preventiva-i-higijena/'}]}};
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{alt.map(a=><link rel="alternate" hreflang={a.l} href={a.href}/>)}{alt.length>0&&<link rel="alternate" hreflang="x-default" href={alt[0].href}/>}<meta property="og:type" content={type}/><meta property="og:locale" content={OG_LOCALE[lang]}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(image,Astro.site).href}/><meta property="og:url" content={canonical}/><meta name="robots" content="index,follow"/><link rel="stylesheet" href="/site.css"/><script type="application/ld+json" set:html={JSON.stringify(structured)}/></head><body><slot /></body></html>
